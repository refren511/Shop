<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.shop.MainMenuController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <MenuBar>
                    <menus>
                        <Menu text="Файл">
                            <items>
                                <MenuItem onAction="#handleClose" text="Закрыть" />
                            </items>
                        </Menu>
                        <Menu text="Заказы">
                            <items>
                                <MenuItem onAction="#handleShowOrders" text="Посмотреть все заказы" />
                                <MenuItem onAction="#handleShowStatistics" text="Просмотреть статистику" />
                            </items>
                        </Menu>
                        <Menu text="Товары">
                            <items>
                                <MenuItem onAction="#selectCatalogTab" text="Посмотреть каталог товаров" />
                                <MenuItem onAction="#openCatalogWindow" text="Открыть каталог в новом окне" />
                            </items>
                        </Menu>
                        <Menu text="Помощь">
                            <items>
                                <MenuItem onAction="#handleAbout" text="О программе" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </top>
            <center>
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab fx:id="catalogtab" text="Товары">
                            <content>
                                <AnchorPane />
                            </content>
                        </Tab>
                        <Tab fx:id="orderTab" text="Заказы">
                            <content>
                                <HBox spacing="15.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                    <children>

                                        <VBox minWidth="250.0" prefWidth="225.0" spacing="10.0">
                                            <children>
                                                <Label text="Список заказов" />
                                                <TextField fx:id="searchField" promptText="Поиск по номеру или имени..." />

                                                <TableView fx:id="ordersTable" prefHeight="282.0" prefWidth="284.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="orderIdCol" prefWidth="120.0" text="Номер заказа" />
                                                        <TableColumn fx:id="orderLoginCol" prefWidth="150.0" text="Фамилия И.О." />
                                                    </columns>
                                                    <placeholder>
                                                        <Label text="No content in table" />
                                                    </placeholder>
                                                </TableView>
                                            </children>
                                        </VBox>

                                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Информация о заказе" />

                                                <GridPane hgap="15.0" vgap="15.0" VBox.vgrow="ALWAYS">
                                                    <columnConstraints>
                                                        <ColumnConstraints halignment="LEFT" maxWidth="106.45283452350093" minWidth="10.0" prefWidth="94.45283452350093" />
                                                        <ColumnConstraints halignment="LEFT" maxWidth="130.35849493345205" minWidth="10.0" prefWidth="129.35849493345205" />
                                                        <ColumnConstraints halignment="LEFT" maxWidth="81.188682634918" minWidth="10.0" prefWidth="69.188682634918" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                        <RowConstraints minHeight="10.0" vgrow="ALWAYS" />
                                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                    </rowConstraints>
                                                    <children>
                                                        <Label text="Номер заказа" GridPane.rowIndex="0" />
                                                        <Label fx:id="orderNumberLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                        <Label text="Статус заказа" GridPane.rowIndex="1" />
                                                        <ComboBox fx:id="statusCombo" promptText="Выберите с..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                        <Hyperlink onAction="#handleEditOrder" prefHeight="24.0" prefWidth="94.0" text="Изменить" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                                                        <Label text="Товары в заказе" GridPane.rowIndex="2" GridPane.valignment="TOP" />

                                                        <TableView fx:id="orderProductsTable" prefHeight="157.0" prefWidth="202.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="productNameCol" prefWidth="75.0" text="Наименование" />
                                                                <TableColumn fx:id="productCountCol" prefWidth="70.16983032226562" text="Кол-во" />
                                                                <TableColumn fx:id="productSumCol" prefWidth="80.16987609863281" text="Цена" />
                                                            </columns>
                                                            <placeholder>
                                                                <Label text="No content in table" />
                                                            </placeholder>
                                                        </TableView>

                                                        <Label text="Сумма заказа" GridPane.rowIndex="3" />
                                                        <Label fx:id="orderSumLabel" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                    </children>
                                                </GridPane>

                                                <HBox alignment="CENTER" spacing="20.0">
                                                    <children>
                                                        <Button onAction="#handleSaveOrder" mnemonicParsing="false" text="Сохранить" />
                                                        <Button onAction="#handleCancelOrder" mnemonicParsing="false" text="Отмена" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </center>
            <bottom>
                <Label text="данное приложение создано студентом 09-552 Иванов Арсений Владиславович" BorderPane.alignment="CENTER" />
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
